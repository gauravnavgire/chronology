   "window": [
    "1999-05",
    "1999-05"
   ],
   "keywords": [
    "grave"
   ],
   "must": true,
   "vague": false
  },
  {
   "key": "sailing-1975",
   "window": [
    "1975-06-01",
    "1975-08-31"
   ],
   "keywords": [
    "sail",
    "summer"
   ],
   "must": true,
   "vague": true
  },
  {
   "key": "letter",
   "window": [
    "1999-06-02",
    "1999-06-02"
   ],
   "keywords": [
    "lawyer",
    "letter"
   ],
   "must": true,
   "vague": false
  },
  {
   "key": "sell-boat",
   "window": [
    "2012",
    "2012"
   ],
   "keywords": [
    "sell",
    "boat"
   ],
   "must": true,
   "vague": false
  },
  {
   "key": "porto",
   "window": [
    "1988",
    "1988"
   ],
   "keywords": [
    "porto",
