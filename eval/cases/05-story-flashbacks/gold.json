  },
  {
   "key": "box",
   "window": [
    "1999-06",
    "1999-06"
   ],
   "keywords": [
    "box"
   ],
   "must": true,
   "vague": false
  },
  {
   "key": "daughter",
   "window": [
    "2020",
    "2020"
   ],
   "keywords": [
    "daughter"
   ],
   "must": true,
   "vague": false
  }
 ],
 "expect": {
  "layout": "telling",
  "answer_patterns": [
   "(?i)flash-?back[\\s\\S]{0,400}1975|1975[\\s\\S]{0,400}flash-?back",
   "(?i)flash-?forward[\\s\\S]{0,400}2012|2012[\\s\\S]{0,400}flash-?forward"
